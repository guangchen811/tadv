        <mxCell id="J6Wc3xxelYBP2Xc5JhN7-1" value="+ Divide constraints into groups to generate them separately. Maybe we should start with the easy ones and then provide them to LLMs when generating harder ones." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="PSlwRSmnbaZ5S8H-IUAg-2" vertex="1">
